# Select exactly one backend target. The application has no implicit fallback.
ECHOSENSE_BACKEND_BASE_URL=http://192.168.1.93:8000
# Production: https://echosense-backend-75h3.onrender.com

# Provision these values through the backend's admin-only device routes.
# Never commit the generated key or print it in logs.
ECHOSENSE_DEVICE_ID=classroom-101-pi
ECHOSENSE_DEVICE_KEY=replace-with-secure-generated-key

# Durable delivery defaults (override only when operationally required).
ECHOSENSE_OUTBOX_ENABLED=true
ECHOSENSE_OUTBOX_DATABASE_PATH=data/alert_outbox.sqlite3
