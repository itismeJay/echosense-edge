# EchoSense edge settings. Copy to edge.env (gitignored) in the repo root:
#
#     cp edge.env.example edge.env && chmod 600 edge.env
#
# The same commit runs on the Mac and the Raspberry Pi. Everything that differs
# between machines lives here. config.py loads edge.env at startup; variables
# already exported by the shell, the demo scripts or systemd's EnvironmentFile
# always win. ECHOSENSE_ENV_FILE=/path picks another file ("" disables loading).
# Relative paths below are resolved against the repo root.
# Never commit edge.env and never paste the device key into chat or logs.

# --- Backend (required, no fallback) -----------------------------------------
# Mac, local backend:  http://localhost:8000
# Pi, LAN backend:     http://192.168.1.93:8000
# Production (both):   https://echosense-backend-75h3.onrender.com
# The demo scripts (edge-local.sh / edge-live.sh) set this themselves.
ECHOSENSE_BACKEND_BASE_URL=http://localhost:8000

# --- Device credentials (required) -------------------------------------------
# Issued once by the backend's admin device routes. Mac and Pi may share one
# registered device or use separate ones.
ECHOSENSE_DEVICE_ID=classroom-101-pi
ECHOSENSE_DEVICE_KEY=replace-with-secure-generated-key

# --- Platform ----------------------------------------------------------------
# Auto-detected: "macos" on a Mac, "raspberrypi" from /proc/device-tree/model,
# otherwise "linux". Set only to override detection.
# ECHOSENSE_PLATFORM=

# --- Microphone --------------------------------------------------------------
# Case-insensitive name match (exact first, then substring) against the input
# devices PyAudio lists. Default: "EMEET M0 Plus".
# Pi EMEET:      EMEET M0 Plus  (the code's default)
# Mac built-in:  MacBook
# Mac EMEET:     EMEET  (what edge-local.sh --mic emeet sets)
ECHOSENSE_PREFERRED_MICROPHONE="EMEET M0 Plus"
# true (default) refuses to start if the named mic is missing; false falls
# back to the first input device.
# ECHOSENSE_MICROPHONE_STRICT=true

# --- Models ------------------------------------------------------------------
# Defaults are repo-relative: yamnet.tflite and yamnet_class_map.csv.
# ECHOSENSE_YAMNET_MODEL_PATH=yamnet.tflite
# ECHOSENSE_YAMNET_CLASSES_PATH=yamnet_class_map.csv
# faster-whisper model: a size name (default "base") or a local model folder.
# Mac and Pi both default to "base"; the Pi CPU is the limit on going larger.
# ECHOSENSE_WHISPER_MODEL=base
# Legacy Vosk models (model/vosk_detect.py only; the live runtime does not use them).
# ECHOSENSE_VOSK_FILIPINO_MODEL_PATH=vosk-model-tl-ph-generic-0.6
# ECHOSENSE_VOSK_ENGLISH_MODEL_PATH=vosk-model-small-en-us-0.15

# --- Data and log folders ----------------------------------------------------
# Default: data/ and logs/ in the repo. On the Pi these may point elsewhere,
# e.g. /var/lib/echosense and /var/log/echosense.
# ECHOSENSE_DATA_DIR=data
# ECHOSENSE_LOG_DIR=logs
# Alert outbox database. Default: <ECHOSENSE_DATA_DIR>/alert_outbox.sqlite3.
# The demo scripts use data/alert_outbox.<local|live>.sqlite3 per backend.
# ECHOSENSE_OUTBOX_DATABASE_PATH=data/alert_outbox.sqlite3
# ECHOSENSE_OUTBOX_ENABLED=true

# --- Network identity (log banner and heartbeat) -----------------------------
# Interface whose IP/MAC is reported. Default: en0 on macOS, wlan0 elsewhere.
# ECHOSENSE_NETWORK_INTERFACE=wlan0
# Hostname reported to the backend. Default: this machine's hostname.
# ECHOSENSE_HOSTNAME=raspberrypi

# --- Diagnostics -------------------------------------------------------------
# Logs exact finalized transcripts locally (never sent to the backend).
# ECHOSENSE_SHOW_TRANSCRIPT_TEXT=false

# Detection tuning (ECHOSENSE_INCIDENT_WINDOW_SECONDS, ECHOSENSE_FILTER_*, ...)
# is identical on both machines; see config.py and detection/false_alarm_filters.py.
