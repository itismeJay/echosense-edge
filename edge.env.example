# EchoSense edge settings. Copy to edge.env (gitignored) in the repo root:
#
#     cp edge.env.example edge.env && chmod 600 edge.env
#
# The same commit runs on the Mac and the Raspberry Pi. Everything that differs
# between machines lives here. config.py loads edge.env at startup; variables
# already exported by the shell, the demo scripts or systemd's EnvironmentFile
# always win. ECHOSENSE_ENV_FILE=/path picks another file ("" disables loading).
# Relative paths below are resolved against the repo root.
# Never commit edge.env and never paste the device key into chat or logs.

# --- Backend (required, no fallback) -----------------------------------------
# Mac, local backend:  http://localhost:8000
# Pi, LAN backend:     http://192.168.1.93:8000
# Production (both):   https://echosense-backend-75h3.onrender.com
# The demo scripts (edge-local.sh / edge-live.sh) set this themselves.
ECHOSENSE_BACKEND_BASE_URL=http://localhost:8000

# Dashboard Test Mode is intentionally not enabled in edge.env. Use the
# foreground tools/dashboard_test_mode.py runner documented in
# docs/DASHBOARD_TEST_MODE.md. It requires explicit live-capture and delivery
# acknowledgements, requires exact approval for any non-local backend, uses a
# dedicated test outbox, and sets ECHOSENSE_DASHBOARD_TEST_MODE only for that
# process.

# --- Device identity: QR setup (recommended) ----------------------------------
# tools/provision_box.py writes identity.json for a box (device code, setup code,
# box secret) and prints its QR label. Put it here (chmod 600). On start, a box
# with an identity but no key says "Waiting to be added to a classroom" and polls
# the backend every 10 s; when a school admin scans the label (Classrooms > Add
# device) the box receives its key once, saves it to device_credentials.json
# (owner-only) and starts. Nobody ever types the key. Default paths:
# ECHOSENSE_IDENTITY_FILE=data/identity.json
# ECHOSENSE_DEVICE_CREDENTIALS_FILE=data/device_credentials.json   (next to identity)
# ECHOSENSE_ACTIVATION_POLL_SECONDS=10
# ECHOSENSE_ACTIVATION_ANNOUNCE_SECONDS=180
# Spoken prompts: Mac uses `say`; the Pi uses espeak-ng/espeak/spd-say if installed
# (sudo apt install espeak-ng). Override or turn off ("off"):
# ECHOSENSE_SPEAK_COMMAND=espeak-ng -s 150

# --- Device credentials: manual key (Advanced) --------------------------------
# Only without an identity file (or for the same device code): a key issued by
# the dashboard's Advanced flow. Mac and Pi may share one registered device or
# use separate ones.
ECHOSENSE_DEVICE_ID=classroom-101-pi
ECHOSENSE_DEVICE_KEY=replace-with-secure-generated-key

# --- Platform ----------------------------------------------------------------
# Auto-detected: "macos" on a Mac, "raspberrypi" from /proc/device-tree/model,
# otherwise "linux". Set only to override detection.
# ECHOSENSE_PLATFORM=

# --- Microphone --------------------------------------------------------------
# Case-insensitive name match (exact first, then substring) against the input
# devices PyAudio lists. Default: "EMEET M0 Plus".
# Pi EMEET:      EMEET M0 Plus  (the code's default)
# Mac built-in:  MacBook
# Mac EMEET:     EMEET  (what edge-local.sh --mic emeet sets)
ECHOSENSE_PREFERRED_MICROPHONE="EMEET M0 Plus"
# true (default) refuses to start if the named mic is missing; false falls
# back to the first input device.
# ECHOSENSE_MICROPHONE_STRICT=true

# --- Models ------------------------------------------------------------------
# Defaults are repo-relative: yamnet.tflite and yamnet_class_map.csv.
# ECHOSENSE_YAMNET_MODEL_PATH=yamnet.tflite
# ECHOSENSE_YAMNET_CLASSES_PATH=yamnet_class_map.csv
# faster-whisper model: a size name (default "base") or a local model folder
# (repo-relative paths work). The deployment school speaks Bisaya, so choose by
# Bisaya recall. Recommended on Mac and Pi: the Apache-2.0 Cebuano fine-tune of
# whisper-small, converted to CTranslate2 int8 (~240 MB, ~3 s/utterance on a
# Pi 5). Copy the models/ folder to the Pi; it is not in git.
#   test set: Bisaya recall 100% vs 91% stock small, 45% stock base (tl).
# ECHOSENSE_WHISPER_MODEL=models/sapinsapin_whisper-small-pld-ceb-ct2-int8
# Decode language: tl (default; Whisper has no Cebuano), auto, en or tl+en.
# ECHOSENSE_WHISPER_LANGUAGE=tl
# Primary transcriber (model/stt_provider.py): elevenlabs or whisper. Default:
# elevenlabs when ELEVENLABS_API_KEY is set, else whisper. ElevenLabs is always
# used: a failed utterance is queued in memory (max 200 clips / 30 min of audio,
# oldest dropped) and retried in order every 30 s; late results are detected
# with the original speech time. Only after OUTAGE_MINUTES of continuous
# failure does Whisper take new utterances and drain the queue; ElevenLabs is
# probed every 60 s and resumes on the first success. Spelling hints:
# lexicon/stt_keyterms.txt (200 single words). Log: [STT] provider=..., queued,
# retry, outage_mode=on/off.
# ELEVENLABS_API_KEY=
# ECHOSENSE_STT_PROVIDER=elevenlabs
# ECHOSENSE_ELEVENLABS_MODEL=scribe_v3
# ECHOSENSE_ELEVENLABS_LANGUAGE=ceb
# ECHOSENSE_ELEVENLABS_TIMEOUT_S=15
# ECHOSENSE_ELEVENLABS_OUTAGE_MINUTES=30
# Drop a matched term when ElevenLabs' word confidence exp(logprob) is below
# this (threats: the urgent floor). Recorded bullying clips scored >= 0.53.
# ECHOSENSE_FILTER_ELEVENLABS_WORD_PROBABILITY=true
# ECHOSENSE_FILTER_ELEVENLABS_WORD_PROBABILITY_MIN=0.05
# ECHOSENSE_FILTER_ELEVENLABS_URGENT_WORD_PROBABILITY_MIN=0.02

# --- Tone: speech emotion (emotion2vec_plus_base, ONNX) ----------------------
# Runs on each utterance in parallel with ElevenLabs. Same file on Mac and Pi:
# models/emotion2vec_plus_base.onnx (373 MB, from tools/export_emotion2vec.py;
# copy it to the Pi). Missing model = no angry tone, everything else works.
# Angry tone = emotion angry >= ANGRY_MIN AND (YAMNet shout >= SHOUT_MIN OR
# speech louder than RMS_RATIO x the recent-speech median OR a shout tag).
# Volume alone is never aggressive. See detection/tone_vote.py.
# ECHOSENSE_EMOTION_ENABLED=true
# ECHOSENSE_EMOTION_MODEL=models/emotion2vec_plus_base.onnx
# ECHOSENSE_EMOTION_THREADS=2
# ECHOSENSE_EMOTION_TIMEOUT_SECONDS=5
# ECHOSENSE_TONE_ANGRY_MIN=0.6
# ECHOSENSE_TONE_SHOUT_MIN=0.3
# ECHOSENSE_TONE_RMS_RATIO=2.5
# ECHOSENSE_TONE_LAUGH_MIN=0.3
# ECHOSENSE_TONE_BASELINE_UTTERANCES=30
# Claude semantic classifier (detection/llm_semantic.py): judges each
# utterance as insult/threat/exclusion/shaming/banter/friendly_slang/... to
# lower joking to LOW ("check context") and to alert on targeted bullying the
# word list misses ("detected by meaning"). Every accepted transcript is sent
# to the Anthropic API in mode "all"; "on_match" sends only word-list hits.
# Timeout or error: lexicon-only. The key is never logged.
# ECHOSENSE_SEMANTIC_MODE=all            # off | on_match | all
# ANTHROPIC_API_KEY=
# ECHOSENSE_SEMANTIC_MODEL=claude-haiku-5-5
# ECHOSENSE_SEMANTIC_TIMEOUT_S=4
# Experimental sentence semantics are disabled by default. Enabling this flag
# only activates bounded shadow evidence; without an explicitly injected local
# classifier adapter, status remains "unavailable" and alert decisions do not
# change. No model is downloaded at runtime.
# ECHOSENSE_EXPERIMENTAL_SEMANTICS=false
# ECHOSENSE_SEMANTIC_MIN_CONFIDENCE=0.75
# ECHOSENSE_SEMANTIC_CONTEXT_TURNS=6
# ECHOSENSE_SEMANTIC_CONTEXT_SECONDS=90
# ECHOSENSE_SEMANTIC_CONTEXT_CHARS=4000
# The offline evaluation adapter additionally requires an approved local model
# snapshot. These settings do not cause downloads and runtime does not load the
# adapter automatically.
# ECHOSENSE_SEMANTIC_MODEL_DIR=models/multilingual-MiniLMv2-L12-mnli-xnli
# ECHOSENSE_SEMANTIC_MODEL_ID=multilingual-MiniLMv2-L12-mnli-xnli
# ECHOSENSE_SEMANTIC_MAX_LENGTH=256
# Legacy Vosk models (model/vosk_detect.py only; the live runtime does not use them).
# ECHOSENSE_VOSK_FILIPINO_MODEL_PATH=vosk-model-tl-ph-generic-0.6
# ECHOSENSE_VOSK_ENGLISH_MODEL_PATH=vosk-model-small-en-us-0.15

# --- Data and log folders ----------------------------------------------------
# Default: data/ and logs/ in the repo. On the Pi these may point elsewhere,
# e.g. /var/lib/echosense and /var/log/echosense.
# ECHOSENSE_DATA_DIR=data
# ECHOSENSE_LOG_DIR=logs
# Alert outbox database. Default: <ECHOSENSE_DATA_DIR>/alert_outbox.sqlite3.
# The demo scripts use data/alert_outbox.<local|live>.sqlite3 per backend.
# ECHOSENSE_OUTBOX_DATABASE_PATH=data/alert_outbox.sqlite3
# ECHOSENSE_OUTBOX_ENABLED=true

# --- Network identity (log banner and heartbeat) -----------------------------
# Interface whose IP/MAC is reported. Default: en0 on macOS, wlan0 elsewhere.
# ECHOSENSE_NETWORK_INTERFACE=wlan0
# Hostname reported to the backend. Default: this machine's hostname.
# ECHOSENSE_HOSTNAME=raspberrypi

# Phone-assisted Wi-Fi recovery is a separate, root-hardened service. These are
# documented here for one-codebase visibility; do not enable it until the
# read-only Pi preflight and rollback review in docs/WIFI_PROVISIONING.md pass.
# Client Wi-Fi passwords are never stored in this file.
# ECHOSENSE_WIFI_INTERFACE=wlan0
# ECHOSENSE_WIFI_SETUP_CREDENTIALS=/etc/echosense/wifi-setup.json
# ECHOSENSE_WIFI_RUNTIME_DIRECTORY=/run/echosense-wifi
# ECHOSENSE_WIFI_RECOVERY_SECONDS=45
# ECHOSENSE_WIFI_POLL_SECONDS=5

# --- Diagnostics -------------------------------------------------------------
# Logs exact finalized transcripts locally (never sent to the backend), plus
# ElevenLabs audio events ([STT_EVENTS] "(laughs)") and word logprobs ([STT_WORDS]).
# ECHOSENSE_SHOW_TRANSCRIPT_TEXT=false

# Detection tuning (ECHOSENSE_INCIDENT_WINDOW_SECONDS, ECHOSENSE_FILTER_*, ...)
# is identical on both machines; see config.py and detection/false_alarm_filters.py.
